# Copy this file to a local profile file such as .env.abc or .env.client-a.
# Profile files are ignored by git.
BASE_URL=
# Optional friendly name used in per-site reports. Defaults to BASE_URL hostname.
SITE_NAME=
# Resident login for this ecomm site.
RESIDENT_FIRST_NAME=
RESIDENT_ROOM=
RESIDENT_PIN=

# Optional dynamic selection controls.
SELECTION_MODE=first
TARGET_REVENUE_CENTER=
TARGET_MENU=
TARGET_ITEM=
KITCHEN_MESSAGE=Servingintel test. Please do not make!

# Optional focused coverage.
RUN_SEARCH_TEST=false
SEARCH_ITEM_NAME=
RUN_MULTI_ITEM_ORDER=false
RUN_PAYMENT_FAILURE_TEST=false
INVALID_RESIDENT_FIRST_NAME=
INVALID_RESIDENT_ROOM=
INVALID_RESIDENT_PIN=

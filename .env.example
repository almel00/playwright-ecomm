# Copy this file to .env and fill in values for the resident ordering test account.
BASE_URL=https://abcseniorliving.servingintel.app/

# Resident login
RESIDENT_FIRST_NAME=
RESIDENT_ROOM=
RESIDENT_PIN=

# Optional checkout controls. Defaults are usually fine.
HEADLESS=true
BROWSER=chromium
SLOW_MO_MS=0
SCREENSHOT_ON_FAILURE=true

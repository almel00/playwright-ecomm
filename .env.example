# Copy this file to .env and fill in values for the resident ordering test account.
BASE_URL=https://abcseniorliving.servingintel.app/

# Resident login
RESIDENT_FIRST_NAME=
RESIDENT_ROOM=
RESIDENT_PIN=

# Optional dynamic selection controls.
# SELECTION_MODE can be first or random.
SELECTION_MODE=first
TARGET_REVENUE_CENTER=
TARGET_MENU=
TARGET_ITEM=
KITCHEN_MESSAGE=Servingintel test. Please do not make!

# Optional focused coverage. Disabled by default because these require fixture data
# or may place extra real orders.
RUN_SEARCH_TEST=false
SEARCH_ITEM_NAME=
RUN_MULTI_ITEM_ORDER=false
RUN_PAYMENT_FAILURE_TEST=false
INVALID_RESIDENT_FIRST_NAME=
INVALID_RESIDENT_ROOM=
INVALID_RESIDENT_PIN=
